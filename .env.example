# Bits & Tools Environment Configuration

# Production Site URL (used for canonical URLs, sitemaps, robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.bitsandtools.com

# Public Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=sharmaaditya14jul@gmail.com

# -------------------------------------------------------------
# Advertising & Monetization (Disabled by default)
# -------------------------------------------------------------
# Set to 'true' to enable advertising scripts and slots in production
NEXT_PUBLIC_ADS_ENABLED=false

# Advertising provider: 'adsense' | 'ezoic' | 'custom'
NEXT_PUBLIC_AD_PROVIDER=adsense

# Google AdSense Publisher ID (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional individual AdSense slot IDs (obtain from AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_CONTENT=

# Enable visual slot outlines in development for layout testing without loading ads
NEXT_PUBLIC_ADS_DEBUG=false

# -------------------------------------------------------------
# Analytics & Verification (Disabled by default)
# -------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_CODE=
